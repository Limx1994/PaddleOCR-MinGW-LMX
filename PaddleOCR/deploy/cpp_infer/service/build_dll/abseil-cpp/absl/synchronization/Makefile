	cd /d D:\tmp\tmp\PaddleOCR\deploy\cpp_infer\service\build_dll && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
